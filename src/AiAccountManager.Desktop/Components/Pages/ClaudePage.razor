    private static string? GetQuotaCheckedAtText(ClaudeQuotaSnapshot.View? quota) {
        if (quota?.Snapshot is ClaudeQuotaSnapshot snapshot) {
            return quota.Status == ClaudeQuotaSnapshot.RefreshStatus.Fresh
                ? $"額度快照時間：{FormatDateTime(snapshot.RetrievedAtUtc)}"
                : $"最近成功快照：{FormatDateTime(snapshot.RetrievedAtUtc)}";
        }

        return quota?.LastAttemptAtUtc is DateTimeOffset lastAttemptAtUtc
            ? $"最近查詢嘗試：{FormatDateTime(lastAttemptAtUtc)}"
            : null;
    }

    private static string? GetQuotaMessage(ClaudeQuotaSnapshot.View? quota) {
        if (quota is null) {
            return null;
        }

        string? message = quota.Message;
        if (quota.RetryAfterUtc is not DateTimeOffset retryAfterUtc) {
            return message;
        }

        string retryMessage = $"最早可於 {FormatDateTime(retryAfterUtc)} 再次查詢。";
        return string.IsNullOrWhiteSpace(message)
            ? retryMessage
            : $"{message} {retryMessage}";
    }

    private static string FormatDateTime(DateTimeOffset? value) {
        return value is DateTimeOffset timestamp
            ? timestamp.ToLocalTime().ToString("yyyy/MM/dd HH:mm", CultureInfo.CurrentCulture)
            : "未知";
    }

    private static string? FormatIdentifier(string? value) {
        if (string.IsNullOrWhiteSpace(value)) {
            return null;
        }

        string normalized = value.Trim();
        return normalized.Length > 20
            ? $"{normalized[..8]}…{normalized[^6..]}"
            : normalized;
    }

    private bool CanRefreshQuota(ClaudeAccountProfile profile) {
        return hasLoadedPage && pageState?.Profiles.Any(candidate => candidate.ProfileId == profile.ProfileId) == true;
    }

    private bool CanRequestSwitch(ClaudeAccountProfile profile) {
        ClaudeAccountService.CurrentIdentity? identity = pageState?.CurrentIdentity;
        return hasLoadedPage && !IsRecoveryRequired
            && !IsCleanupPending
            && profile.Status == ClaudeAccountProfile.VerificationStatus.Verified
            && identity is { Status: ClaudeAccountService.IdentityStatus.Verified, MatchedProfile: not null }
            && identity.MatchedProfile.ProfileId is Guid currentProfileId
            && currentProfileId != profile.ProfileId;
    }

    private string? SwitchDisabledReason(ClaudeAccountProfile profile) {
        if (IsRecoveryRequired) {
            return "先完成待復原交易，才能開始新切換。";
        }

        if (IsCleanupPending) {
            return "切換已完成，請先重試清理交易暫存，再開始新切換。";
        }

        if (profile.Status != ClaudeAccountProfile.VerificationStatus.Verified) {
            return profile.Status == ClaudeAccountProfile.VerificationStatus.ReauthenticationRequired
                ? "此帳號需要重新驗證，請在 Claude Desktop 登入後重新保存。"
                : "此帳號尚未通過驗證，無法作為切換目標。";
        }

        ClaudeAccountService.CurrentIdentity? identity = pageState?.CurrentIdentity;
        if (identity is { Status: ClaudeAccountService.IdentityStatus.Verified, MatchedProfile: null }) {
            return "目前 Claude Desktop 帳號已驗證，但無法與已保存帳號安全配對，因此不能切換。";
        }

        if (identity is not { Status: ClaudeAccountService.IdentityStatus.Verified, MatchedProfile: not null }) {
            return "目前 Claude Desktop 身分尚未驗證，無法安全切換。";
        }

        if (identity.MatchedProfile.ProfileId == profile.ProfileId) {
            return "此帳號就是目前 Claude Desktop 使用中的帳號。";
        }

        return null;
    }

    private bool CanCaptureCurrentProfile => hasLoadedPage && !isBusy
        && !IsRecoveryRequired
        && pageState?.ProcessStatus == IClaudeDesktopProcessController.ProcessStatus.NotRunning
        && pageState?.CurrentIdentity.Status is ClaudeAccountService.IdentityStatus.Unknown or ClaudeAccountService.IdentityStatus.Verified;

    private string? CaptureDisabledReason {
        get {
            if (isBusy) {
                return "請等目前作業完成後再保存帳號。";
            }

            if (IsRecoveryRequired) {
                return "先完成待復原交易，才能保存或更新 profile。";
            }

            if (pageState?.ProcessStatus == IClaudeDesktopProcessController.ProcessStatus.Running) {
                return "請先正常結束 Claude Desktop，再保存目前帳號。";
            }

            if (pageState?.ProcessStatus != IClaudeDesktopProcessController.ProcessStatus.NotRunning) {
                return "目前無法確認 Claude Desktop 已停止，暫時不能保存帳號。";
            }

            return pageState?.CurrentIdentity.Status switch {
                ClaudeAccountService.IdentityStatus.ReauthenticationRequired => "請先在 Claude Desktop 重新登入，再重新讀取身分。",
                ClaudeAccountService.IdentityStatus.Mismatch => "身分資料不一致，為避免保存錯誤帳號，已停用此操作。",
                ClaudeAccountService.IdentityStatus.UnsupportedInstallation => "目前 Claude Desktop 安裝不受支援，無法保存 profile。",
                ClaudeAccountService.IdentityStatus.AmbiguousInstallation => "目前找到多個安裝位置，無法安全保存 profile。",
                _ => null
            };
        }
    }

    private static string SwitchResultMessage(ClaudeDesktopSwitchService.SwitchOutcome outcome, bool isRecovery) {
        return (outcome, isRecovery) switch {
            (ClaudeDesktopSwitchService.SwitchOutcome.Succeeded, false) => "Claude Desktop 已切換至目標帳號。",
            (ClaudeDesktopSwitchService.SwitchOutcome.Succeeded, true) => "切換復原已完成。",
            (ClaudeDesktopSwitchService.SwitchOutcome.FailedRolledBack, _) => "切換失敗，原帳號設定已復原。",
            (ClaudeDesktopSwitchService.SwitchOutcome.RecoveryRequired, _) => "切換尚未完成，交易資料已保留。請重試復原。",
            (ClaudeDesktopSwitchService.SwitchOutcome.CleanupPending, _) => "帳號切換已完成，交易暫存清理待重試。",
            (ClaudeDesktopSwitchService.SwitchOutcome.Blocked, _) => "目前狀態不允許執行此作業。",
            _ => "切換未執行，請重新載入狀態後再試。"
        };
    }

    private static Severity SwitchResultSeverity(ClaudeDesktopSwitchService.SwitchOutcome outcome) {
        return outcome switch {
            ClaudeDesktopSwitchService.SwitchOutcome.Succeeded => Severity.Success,
            ClaudeDesktopSwitchService.SwitchOutcome.FailedRolledBack => Severity.Error,
            ClaudeDesktopSwitchService.SwitchOutcome.RecoveryRequired => Severity.Error,
            ClaudeDesktopSwitchService.SwitchOutcome.CleanupPending => Severity.Warning,
            ClaudeDesktopSwitchService.SwitchOutcome.Blocked or ClaudeDesktopSwitchService.SwitchOutcome.Rejected => Severity.Warning,
            _ => Severity.Error
        };
    }

    private void ClearOperationMessage() {
        pageError = null;
        operationMessage = null;
        operationSeverity = Severity.Info;
    }

    private bool CanEditCatalog => hasLoadedPage && !isBusy && !IsRecoveryRequired && !IsCleanupPending;

    private string? CatalogDisabledReason => IsRecoveryRequired || IsCleanupPending
        ? "有尚未完成的切換交易，完成復原或清理前無法變更帳號清單。"
        : null;

    private async Task UpdateAliasAsync(ClaudeAccountProfile profile, string? alias) {
        await RunCatalogActionAsync(() => Accounts.UpdateAliasAsync(
            profile.ProfileId,
            alias,
            pageLifetimeCancellation.Token
        ));
    }

    private async Task MoveProfileAsync(ClaudeAccountProfile profile, ClaudeAccountService.MoveDirection direction) {
        await RunCatalogActionAsync(() => Accounts.MoveAsync(
            profile.ProfileId,
            direction,
            pageLifetimeCancellation.Token
        ));
    }

    private void BeginRemove(ClaudeAccountProfile profile) {
        if (CanEditCatalog) {
            removingProfile = profile;
        }
    }

    private Task SetRemoveDialogVisible(bool visible) {
        if (!visible && !(isBusy && activeAction == PageAction.Catalog)) {
            removingProfile = null;
        }

        return Task.CompletedTask;
    }

    private Task CancelRemove() {
        if (!isBusy) {
            removingProfile = null;
        }

        return Task.CompletedTask;
    }

    private async Task RemoveProfileAsync(Guid profileId) {
        if (removingProfile?.ProfileId != profileId) {
            return;
        }

        await RunCatalogActionAsync(() => Accounts.RemoveAsync(profileId, pageLifetimeCancellation.Token));
        removingProfile = null;
    }

    private async Task RunCatalogActionAsync(Func<Task<ClaudeAccountService.MetadataResult>> operation) {
        if (!CanEditCatalog) {
            return;
        }

        await RunPageActionAsync(PageAction.Catalog, async () => {
            ClaudeAccountService.MetadataResult result = await operation();
            if (result.Message is not null) {
                operationMessage = result.Message;
                operationSeverity = result.Saved ? Severity.Success : Severity.Error;
            }

            pageState = Accounts.CurrentPageState;
            await ReloadQuotaViewsAsync(pageState.Profiles);
        });
    }

    private void OnQuotaStateChanged(object? sender, EventArgs e) {
        if (Volatile.Read(ref disposed) != 0 || pageState is null) {
            return;
        }

        _ = InvokeAsync(() => {
            if (Volatile.Read(ref disposed) != 0 || pageState is null) {
                return;
            }

            bool changed = false;
            foreach (ClaudeAccountProfile profile in pageState.Profiles) {
                if (Quotas.GetCurrentView(profile.ProfileId) is ClaudeQuotaSnapshot.View view
                    && (!quotaViews.TryGetValue(profile.ProfileId, out ClaudeQuotaSnapshot.View? existing) || existing != view)) {
                    quotaViews[profile.ProfileId] = view;
                    changed = true;
                }
            }

            if (changed) {
                StateHasChanged();
            }
        });
    }

    private enum PageAction {
        None,
        Reload,
        Capture,
        RefreshQuota,
        PreviewSwitch,
        Switch,
        Recover,
        Catalog
    }
}
