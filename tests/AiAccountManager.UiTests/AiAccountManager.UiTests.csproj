<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>CloudyWing.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>CloudyWing.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <DesktopExecutablePath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\AiAccountManager.Desktop\bin\$(Configuration)\$(TargetFramework)\win-x64\CloudyWing.AiAccountManager.Desktop.exe'))</DesktopExecutablePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI 測試啟動 Desktop 自己的輸出目錄，才能載入 wwwroot 與 static web assets。 -->
    <AssemblyMetadata Include="DesktopExecutablePath" Value="$(DesktopExecutablePath)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只確保 Desktop 先建置；測試以獨立程序啟動它，不載入其組件。 -->
    <ProjectReference Include="..\..\src\AiAccountManager.Desktop\AiAccountManager.Desktop.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>
</Project>
